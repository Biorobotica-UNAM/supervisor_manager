<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <arg    name="namespace"
            default="supervisor"
            description="Top-level namespace for all supervisor nodes"/>  
    <arg    name="ask_data_confirmation_enabled"
            default="true"
            description="Confirm values captured by ask_* + listen before continuing"/>

    <group>
        <push-ros-namespace namespace="$(var namespace)"/>
    
        <node   
            pkg="supervisor_plan" 
            exec="supervisor_plan_node" 
            name="supervisor_plan_node" 
            output="screen">
        </node>

        <node
            pkg="supervisor_system"
            exec="supervisor_system_node"
            name="supervisor_system_node"
            output="screen">
        </node>

        <node
            pkg="supervisor_execution"
            exec="supervisor_execution_node"
            name="supervisor_execution_node"
            output="screen">
        </node>

        <!--node
            pkg="supervisor_manager"
            exec="supervisor_manager_node"
            name="supervisor_manager_node"
            output="screen">
            <param name="ask_data_confirmation_enabled" value="$(var ask_data_confirmation_enabled)"/>
        </node-->
    </group>
</launch>
